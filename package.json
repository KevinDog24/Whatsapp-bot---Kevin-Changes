{
  "name": "builderbot-whatsapp-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot using Builderbot and Baileys, deployed on Railway",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "rollup -c",
    "start": "node dist/app.js",
    "lint": "eslint . --ext .ts"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@builderbot/bot": "^1.2.9",
    "@builderbot/provider-baileys": "^1.2.9",
    "@builderbot-plugins/openai-assistants": "^0.0.2",
    "@whiskeysockets/baileys": "7.0.0-rc.6",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "rollup-plugin-typescript2": "^0.36.0",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.38.0",
    "eslint-plugin-builderbot": "latest",
    "nodemon": "^3.1.10",
    "rollup": "^4.52.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
